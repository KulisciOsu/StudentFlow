# Setup vygeneruje lokální heslo; vlastní hodnotu nastavte před prvním startem DB.
# Hodnota se předá PostgreSQL i API. Soubor .env není verzovaný.
POSTGRES_PASSWORD=

# Volitelný seed: doplňte vlastní údaje a poté zapněte pouze pro lokální vývoj.
DevelopmentSeed__Enabled=false
DevelopmentSeed__MemberEmail=
DevelopmentSeed__TeacherEmail=
DevelopmentSeed__Password=
